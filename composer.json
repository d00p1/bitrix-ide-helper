{
    "name": "d00p1/bitrix-ide-helper",
    "description": "Generate IDE stubs from an installed 1C-Bitrix core and local modules.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^7.0",
        "symfony/finder": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BitrixIdeHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BitrixIdeHelper\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/bitrix-ide-helper"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
